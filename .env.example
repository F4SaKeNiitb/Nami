# ── required for real tasks ──
NAMI_ANTHROPIC_API_KEY=sk-ant-...

# ── sign-in (production is Google-only) ──
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
CHAINLIT_AUTH_SECRET=            # python -c "import secrets;print(secrets.token_hex(32))"
# Redirect URI to register in Google Cloud: https://<host>/chainlit/auth/oauth/google/callback
NAMI_ALLOWED_EMAIL_DOMAINS=      # optional, comma separated

# ── local development only: one fixed account, no Google ──
# NAMI_DEV_AUTH=1
# NAMI_DEV_PASSWORD=dev          # username is dev@nami.local

# ── browsers ──
NAMI_BROWSER_PROVIDER=local      # local | kernel | browser_use
# NAMI_BROWSER_USE_API_KEY=
# NAMI_KERNEL_API_KEY=
NAMI_HEADLESS=true
# inpage: sign-ins happen inside the chat page (no window on the server); window: open a visible browser window
NAMI_TAKEOVER_VIEW=inpage
# Public base URL (production). Used for the Connect Google callback: <url>/chainlit/connect/google/callback
# NAMI_PUBLIC_URL=https://nami.example.com

# ── vault keys ──
NAMI_KMS_PROVIDER=local          # local (dev key in data/dev_kek.key) | azure
# NAMI_AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net
# NAMI_AZURE_KEK_NAME=nami-kek

# ── optional caches (SQLite is the source of truth; Redis only speeds things up) ──
# NAMI_REDIS_URL=redis://localhost:6379/0

# Slack bot (optional). Both set = the bot starts with the server (Socket Mode: no public URL needed). See docs/SLACK.md.
# NAMI_SLACK_BOT_TOKEN=xoxb-...
# NAMI_SLACK_APP_TOKEN=xapp-...

# Model provider. "auto" (default) uses OpenAI when NAMI_OPENAI_API_KEY is set, otherwise Anthropic. Force one with NAMI_LLM_PROVIDER=openai|anthropic.
# NAMI_OPENAI_API_KEY=sk-...
# NAMI_OPENAI_MODEL_MAIN=gpt-5-mini       # defaults (main gpt-5-mini, fast gpt-5-mini, strong gpt-5); NAMI_MODEL_MAIN / NAMI_MODEL_FAST / NAMI_MODEL_STRONG override for either provider
